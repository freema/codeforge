# Build stage — compile the Go binary
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /codeforge-action ./cmd/codeforge-action

# Runtime — minimal image with git + Node.js for CLI installation
# node:22-alpine, not alpine + apk nodejs: Alpine's nodejs package lags behind Node.js security releases
FROM node:22-alpine

# codeforge keeps UID/GID 1000 (the alpine image's), not node's
RUN apk add --no-cache git ca-certificates tzdata su-exec bash \
    && deluser --remove-home node \
    && addgroup -g 1000 codeforge \
    && adduser -D -u 1000 -G codeforge -s /bin/bash -h /home/codeforge codeforge

COPY --from=builder /codeforge-action /usr/local/bin/codeforge-action
COPY deployments/entrypoint-action.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# GitHub Actions runs as root — mark all directories as safe for git
RUN git config --global --add safe.directory '*'

ENTRYPOINT ["/entrypoint.sh"]
